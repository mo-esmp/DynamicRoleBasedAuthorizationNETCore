<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Every project targets both net10.0 and net11.0 (see Directory.Build.props), and each target framework uses the
    ASP.NET Core and EF Core packages of its own major version. The net10.0 values are also the defaults, so the outer
    build of a multi-targeted project, which has no TargetFramework, still sees a version.
  -->
  <PropertyGroup>
    <AspNetCoreBaselineVersion>10.0.0</AspNetCoreBaselineVersion>
    <AspNetCoreVersion>10.0.15</AspNetCoreVersion>
    <EntityFrameworkCoreVersion>10.0.15</EntityFrameworkCoreVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <AspNetCoreBaselineVersion>11.0.0</AspNetCoreBaselineVersion>
    <AspNetCoreVersion>11.0.0</AspNetCoreVersion>
    <EntityFrameworkCoreVersion>11.0.0</EntityFrameworkCoreVersion>
  </PropertyGroup>

  <!--
    The packages depend on the first release of the major version they are built for, so that an application chooses
    its own patch version instead of being forced onto ours. Samples and tests run on the latest patch; transitive
    pinning applies it to the packages they get through the libraries as well.
  -->
  <ItemGroup Label="Libraries" Condition="'$(IsPackable)' == 'true'">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetCoreBaselineVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(AspNetCoreBaselineVersion)" />
  </ItemGroup>

  <ItemGroup Label="Libraries, as samples and tests use them" Condition="'$(IsPackable)' != 'true'">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Samples and tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
