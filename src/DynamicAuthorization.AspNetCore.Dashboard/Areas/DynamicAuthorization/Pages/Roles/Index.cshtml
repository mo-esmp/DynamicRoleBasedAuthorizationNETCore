@page
@model IndexModel
@{
    ViewData["Title"] = "Roles";
}

<div class="da-page-header">
    <div>
        <h1>Roles</h1>
        <p>A role grants a set of permissions. Users get every permission granted to their roles.</p>
    </div>
    <div class="da-page-actions">
        <secure-content asp-page="Create">
            <a class="da-button da-button-primary" asp-page="Create">@DashboardIcons.Add New role</a>
        </secure-content>
    </div>
</div>

@if (Model.Roles.Count == 0)
{
    <div class="da-grid-wrap">
        <div class="da-empty">
            @DashboardIcons.Shield
            No roles yet. <a class="da-link" asp-page="Create">Create the first role</a> to start granting permissions.
        </div>
    </div>
}
else
{
    <div data-filter-scope>
        <div class="da-toolbar">
            <label class="da-search">
                @DashboardIcons.Search
                <input class="da-input" type="search" placeholder="Filter roles" aria-label="Filter roles" data-filter-text />
            </label>
            <span class="da-count" data-filter-count aria-live="polite"></span>
        </div>

        <div class="da-grid-wrap">
            <table class="da-grid">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col" class="da-num">Users</th>
                        <th scope="col" class="da-num">Permissions</th>
                        <th scope="col"><span hidden>Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (RoleSummary role in Model.Roles)
                    {
                        bool superAdmin = Model.SuperAdminRoles.Contains(role.Name);
                        <tr data-row data-search="@role.Name">
                            <td>
                                <a class="da-link" asp-page="Edit" asp-route-id="@role.Id">@role.Name</a>
                                @if (superAdmin)
                                {
                                    <span class="da-badge da-badge-accent">@DashboardIcons.ShieldCheck Super admin</span>
                                }
                            </td>
                            <td class="da-num">@role.UserCount</td>
                            <td class="da-num">@(superAdmin ? "All" : role.PermissionCount)</td>
                            <td class="da-actions">
                                <secure-content asp-page="Edit">
                                    <a class="da-button da-button-subtle da-button-small" asp-page="Edit" asp-route-id="@role.Id">@DashboardIcons.Edit Edit</a>
                                </secure-content>
                                @if (!superAdmin)
                                {
                                    <secure-content asp-page="Edit" asp-page-handler="Delete">
                                        <form method="post" asp-page="Edit" asp-page-handler="Delete" asp-route-id="@role.Id"
                                              data-confirm="Delete the role '@role.Name'? @(role.UserCount == 1 ? "Its user loses" : $"Its {role.UserCount} users lose") the permissions it grants."
                                              data-confirm-title="Delete role" data-confirm-button="Delete">
                                            <button type="submit" class="da-button da-button-subtle da-button-small">@DashboardIcons.Delete Delete</button>
                                        </form>
                                    </secure-content>
                                }
                            </td>
                        </tr>
                    }
                    <tr data-filter-empty hidden>
                        <td colspan="4" class="da-empty">No roles match the filter.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
